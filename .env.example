KAC_FLIGHT_API_KEY=

# Optional: the existing public order backend; no database or API secret needed.
ORDER_API_ORIGIN=https://thingmattersreserve-production.up.railway.app

# Server-only Kakao Quick configuration. Set actual values in Railway Variables.
# Official sandbox endpoints: https://logistics-developers.kakaomobility.com/document/tutorial
KAKAO_QUICK_VENDOR_ID=
KAKAO_QUICK_API_KEY=
KAKAO_LOCAL_REST_API_KEY=
KAKAO_QUICK_BASE_URL=https://open-api-logistics.kakaomobility.com/goa-sandbox-service
KAKAO_QUICK_PICKUP_ADDRESS=서울특별시 강서구 송정로 25
KAKAO_QUICK_PICKUP_DETAIL=1층
KAKAO_QUICK_PICKUP_LATITUDE=37.557402
KAKAO_QUICK_PICKUP_LONGITUDE=126.8115357
KAKAO_QUICK_PICKUP_NAME=NOTHINGMATTERS
KAKAO_QUICK_PICKUP_PHONE=

# Analytics is public/read-only by default, without an ID or password.
# Set private to require Basic Auth for /dashboard/ and /api/dashboard/*.
DASHBOARD_ACCESS_MODE=public
# These always protect Quick order creation/status and /dashboard/quick/admin/.
# Both are also required when DASHBOARD_ACCESS_MODE=private.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Server-only Google analytics credentials. Never put real JSON or exports in Git.
# Christmas Search Console analysis does not require GA4_PROPERTY_ID.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternatively use Base64, not both.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
SEARCH_CONSOLE_SITE_URL=
GA4_PROPERTY_ID=

# Notice admin: server-only credentials; username >= 3 chars, password >= 16 chars.
# No default credentials. /notice/admin/ remains closed until configured.
NOTICE_ADMIN_USERNAME=
NOTICE_ADMIN_PASSWORD=
NOTICE_PUBLIC_ORIGIN=https://nothingmatters.co.kr

# A mounted persistent volume OUTSIDE the web root is required for any write.
# Example: Railway volume at /data, NOTICE_DATA_DIR=/data/notices.
# Railway supplies RAILWAY_VOLUME_MOUNT_PATH automatically. Do not fabricate it.
NOTICE_DATA_DIR=
# For a verified non-Railway Linux volume only; not needed on Railway.
NOTICE_VOLUME_MOUNT_PATH=
# Leave empty in production. "test" works only with NODE_ENV=test and is not durable production storage.
NOTICE_STORAGE_MODE=

# Dear December shared letter tree. Local development uses data/wishing-tree/.
# Production requires a persistent directory; on Railway the mounted volume is
# used automatically as RAILWAY_VOLUME_MOUNT_PATH/wishing-tree.
# Use one server replica for this append-only journal. Back up this private folder.
WISHING_TREE_DATA_DIR=

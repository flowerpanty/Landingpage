KAC_FLIGHT_API_KEY=

# Optional: the existing public order backend; no database or API secret needed.
ORDER_API_ORIGIN=https://thingmattersreserve-production.up.railway.app

# Server-only Kakao Quick configuration. Set actual values in Railway Variables.
# Official sandbox endpoints: https://logistics-developers.kakaomobility.com/document/tutorial
KAKAO_QUICK_VENDOR_ID=
KAKAO_QUICK_API_KEY=
KAKAO_LOCAL_REST_API_KEY=
KAKAO_QUICK_BASE_URL=https://open-api-logistics.kakaomobility.com/goa-sandbox-service
KAKAO_QUICK_PICKUP_ADDRESS=서울특별시 강서구 송정로 25
KAKAO_QUICK_PICKUP_DETAIL=1층
KAKAO_QUICK_PICKUP_LATITUDE=37.557402
KAKAO_QUICK_PICKUP_LONGITUDE=126.8115357
KAKAO_QUICK_PICKUP_NAME=NOTHINGMATTERS
KAKAO_QUICK_PICKUP_PHONE=

# Both are required for Quick order creation/status and /dashboard/quick/admin/.
# The public /dashboard/quick/ page only allows price/time lookup.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

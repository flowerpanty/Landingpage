{
  "name": "nothingmatters-landing",
  "private": true,
  "version": "1.0.0",
  "description": "Static landing page for nothingmatters",
  "scripts": {
    "products:build": "node scripts/build-products.mjs",
    "products:check": "node scripts/build-products.mjs --check",
    "schema:build": "node scripts/generate-jsonld.mjs",
    "schema:check": "node scripts/generate-jsonld.mjs --check",
    "a11y:build": "node scripts/apply-public-accessibility.mjs",
    "a11y:check": "node scripts/test-public-accessibility.mjs",
    "feed:build": "node scripts/generate-feed.mjs",
    "feed:check": "node scripts/generate-feed.mjs --check",
    "site:build": "npm run a11y:build && npm run products:build && npm run schema:build && npm run feed:build",
    "public-seo:test": "node scripts/test-public-seo.mjs",
    "public-perf:test": "node scripts/test-public-performance.mjs",
    "site:check": "npm run products:check && npm run schema:check && npm run public-seo:test && node scripts/test-occasion-landings.mjs && npm run public-perf:test && npm run a11y:check && npm run feed:check",
    "gallery:test": "node scripts/test-gallery-storage.mjs",
    "server:test": "node scripts/test-gimpo-board.mjs && node scripts/test-server-http.mjs",
    "browser:test": "node scripts/test-public-browser.mjs && node scripts/benchmark-gimpo-board.mjs --verify",
    "journal:test": "node scripts/test-wordpress-journal.mjs",
    "order:test": "node scripts/test-order-migration.mjs && node scripts/test-order-confirmation.mjs",
    "prestart": "npm run site:build",
    "start": "node server.js",
    "order:browser:test": "node scripts/test-order-browser.mjs",
    "order:verify-live": "node scripts/verify-order-deployment.mjs"
  }
}
